# Lưu trữ: đặt DATABASE_URL (PostgreSQL, ví dụ Neon miễn phí) để dữ liệu không mất khi máy chủ khởi động lại.
# Để trống thì dùng file JSON tại DB_PATH (chỉ hợp cho chạy thử trên máy).
DATABASE_URL=
DB_PATH=./data/db.json
# Tài khoản quản trị/giáo viên xem báo cáo (username:password). Mật khẩu luôn theo giá trị này mỗi lần khởi động.
ADMIN_ACCOUNT=
# Khóa ký phiên đăng nhập; để trống thì tự sinh và lưu ở data/.session_secret
SESSION_SECRET=
# Tài khoản dùng thử (chỉ môi trường test): tạo khi khởi động và điền sẵn ở trang đăng nhập.
# Để trống trên môi trường thật.
DEMO_ACCOUNT=
# Bật chấm Writing bằng AI (Claude). Để trống thì tính năng tắt.
ANTHROPIC_API_KEY=
WRITING_MODEL=claude-opus-5-5
# Số bài mỗi học viên được chấm mỗi ngày (kiểm soát chi phí API)
WRITING_DAILY_LIMIT=5
